# Copy to .env for LLM-backed generation.
# Without these values the app still runs using the local template fallback.

PORT=8787
CORS_ORIGIN=http://127.0.0.1:5174

# Main generator (Gemini example)
LLM_PROVIDER=gemini
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Or OpenAI-compatible chat completions:
# LLM_PROVIDER=openai-compatible
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL=

# Optional separate reviewer model (otherwise the main LLM is reused)
# LLM_REVIEW_PROVIDER=openai-compatible
# LLM_REVIEW_API_URL=https://api.groq.com/openai/v1/chat/completions
# LLM_REVIEW_API_KEY=
# LLM_REVIEW_MODEL=

# Optional path to a tectonic binary if not on PATH and not under server/bin/
# TECTONIC_PATH=
